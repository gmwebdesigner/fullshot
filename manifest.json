{
  "manifest_version": 3,
  "name": "FullShot",
  "version": "1.0.0",
  "description": "Fast, private full-page screenshots. Capture, annotate and share — everything stays on your machine.",
  "minimum_chrome_version": "109",

  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],

  "action": {
    "default_title": "FullShot — capture this page",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },

  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "options_page": "settings/settings.html",

  "commands": {
    "capture-full-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Capture the full page"
    },
    "capture-visible": {
      "description": "Capture the visible area"
    }
  }
}
